<Window x:Class="TODOList.Client.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TODOList.Client"
        mc:Ignorable="d"
        Title="TODO 회원가입" Height="580" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="WhiteSmoke">
    
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="회원가입" FontSize="28" FontWeight="Bold" Foreground="DarkSlateGray" Margin="0,0,0,8"/>
            <TextBlock Text="가입명과 비밀번호를 입력해 주세요" FontSize="13" Foreground="SlateGray" Margin="0,0,0,26"/>
            
            <TextBlock Text="가입명" Margin="0,0,0,6"/>
            <TextBox x:Name="RegisterNameBox" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock Text="비밀번호" Margin="0,0,0,6"/>
            <PasswordBox x:Name="RegisterPasswordInput" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="비밀번호 확인" Margin="0,0,0,6"/>
            <PasswordBox x:Name="ConfirmPasswordInput" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

            <TextBlock x:Name="RegisterMessage" Text="" Foreground="IndianRed" TextWrapping="Wrap" MinHeight="24" Margin="0,0,0,12"/>
            <Button x:Name="RegisterButton" Click="RegisterButton_Click" Content="회원가입하기" Height="40" Background="SlateBlue" Foreground="White" Margin="0,0,0,10"/>

            <Button x:Name="CancelButton" Content="취소" Height="36" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
