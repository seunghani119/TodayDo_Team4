<Window x:Class="TODOList.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TODOList.Client"
        mc:Ignorable="d"
        Title="TODO 로그인" Height="500" Width="490"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="WhiteSmoke">
    
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="TODO 로그인" FontSize="30" FontWeight="Bold" Foreground="MidnightBlue" Margin="0,0,0,28"/>
            <TextBlock Text="TODO에 로그인하고 나의 일정을 관리하세요" FontSize="13" Foreground="SlateGray" Margin="0,0,0,28"/>
            <TextBlock Text="가입명" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="비밀번호" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordInput" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock x:Name="LoginMessage" Text="" Foreground="Red" TextWrapping="Wrap" MinHeight="24" Margin="0,0,0,12"/>
            <Button x:Name="LoginButton" Click="LoginButton_Click" Content="로그인" Height="40" Background="SlateBlue" Foreground="White" Margin="0,0,0,10"/>
            <Button x:Name="RegisterButton" Content="회원가입하기" Height="36" Click="RegisterButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
