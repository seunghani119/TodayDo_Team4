<Window x:Class="TODOList.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TODOList.Client"
        mc:Ignorable="d"
        Title="TODO 일정관리" Width="1440" Height="900" MinWidth="1240" MinHeight="730" WindowStartupLocation="CenterScreen"
        Background="WhiteSmoke" Foreground="DarkSlateGray" FontFamily="맑은 고딕" FontSize="15">

    <Window.Resources>

        <!-- 공통 버튼 스타일 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Lavender"/>
            <Setter Property="Foreground" Value="DarkSlateBlue"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 둥근 입력란 스타일 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="GhostWhite"/>
            <Setter Property="BorderBrush" Value="Gainsboro"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputSurface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="SlateBlue"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 입력 항목 이름 스타일 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <!-- 일정 목록의 제목 행 -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="GhostWhite"/>
            <Setter Property="Foreground" Value="DarkSlateBlue"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,14"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 일정 목록의 셀 -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 일정 목록의 행 -->
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="WhiteSmoke"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Lavender"/>
                    <Setter Property="Foreground" Value="DarkSlateBlue"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 일정 목록의 일반 글자 -->
        <Style x:Key="TodoCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- 오른쪽 작업 공간 -->
        <Grid Margin="28,28,28,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 상단 제목과 로그아웃 -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="TodayDo" FontSize="16" FontWeight="Bold" Foreground="SlateBlue"/>
                    <TextBlock Text="오늘의 계획을 차근차근" FontSize="28" FontWeight="Bold" Foreground="MidnightBlue" Margin="0,6,0,6"/>
                    <TextBlock Text="활동 시간과 지역을 함께 기록하고, 나의 하루를 정리해 보세요." FontSize="14" Foreground="SlateGray" TextWrapping="Wrap"/>
                </StackPanel>

                <Button x:Name="LogoutButton" Grid.Column="1" Content="로그아웃" Background="SlateBlue" Foreground="White" Padding="20,12" Margin="20,0,0,0" VerticalAlignment="Top" Click="LogoutButton_Click"/>
            </Grid>

            <!-- 일정 목록과 입력란 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- 가운데 일정 목록 -->
                <Border Background="White" CornerRadius="16" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- 나의 일정 제목과 조회 버튼 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 날짜 검색 -->
                            <RowDefinition Height="*"/>
                            <!-- 일정 목록 -->
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="나의 일정" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="계획을 한눈에 확인해 보세요." Foreground="SlateGray" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ViewTodoButton" Content="일정 보기" Margin="0,0,8,0" ToolTip="선택한 일정의 저장된 내용을 자세히 봅니다." Click="ViewTodoButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=TodoGrid}" Value="{x:Null}">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="LoadButton" Content="일정 새로고침" Click="LoadButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- 날짜별 일정 검색 -->
                        <Border Grid.Row="1" Background="GhostWhite" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="날짜별 일정 검색" Foreground="DarkSlateBlue" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DatePicker x:Name="SearchDatePicker" Width="180" HorizontalAlignment="Left" SelectedDateFormat="Short" ToolTip="조회할 날짜를 선택하세요."/>
                                <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button x:Name="SearchButton" Content="검색" Padding="14,8" Margin="0,0,8,0" Click="SearchButton_Click"/>
                                    <Button x:Name="ResetSearchButton" Content="날짜 초기화" Background="White" Padding="14,8" Margin="0,0,8,0" Click="ResetSearchButton_Click"/>
                                    <Button x:Name="PastTodosButton" Content="지난 일정" Background="White" Padding="14,8" Margin="0,0,8,8" Click="PastTodosButton_Click" RenderTransformOrigin="0.499,0.576"/>
                                    <Button x:Name="ShowAllButton" Content="전체 보기" Background="White" Padding="14,8" Click="ShowAllButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <DataGrid x:Name="TodoGrid" SelectionChanged="TodoGrid_SelectionChanged" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="WhiteSmoke" BorderThickness="0" Background="White" RowHeaderWidth="0">
                                <DataGrid.Columns>

                                    <!-- 제목 -->
                                    <DataGridTextColumn Header="제목" Binding="{Binding Title}" ElementStyle="{StaticResource TodoCellTextStyle}" Width="2.2*" MinWidth="160"/>

                                    <!-- 시작 날짜와 시간을 두 줄로 표시 -->
                                    <DataGridTemplateColumn Header="시작" Width="1.6*" MinWidth="128">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TodoDate, StringFormat={}{0:yyyy-MM-dd}}" FontSize="14"/>
                                                    <TextBlock Text="{Binding TodoDate, StringFormat={}{0:HH:mm}}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 종료 날짜와 시간을 두 줄로 표시 -->
                                    <DataGridTemplateColumn Header="종료" Width="1.6*" MinWidth="128">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DueDate, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue=미설정}" FontSize="14"/>
                                                    <TextBlock Text="{Binding DueDate, StringFormat={}{0:HH:mm}}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 지역 -->
                                    <DataGridTextColumn Header="지역" Binding="{Binding LocationName}" ElementStyle="{StaticResource TodoCellTextStyle}" Width="1.8*" MinWidth="150"/>

                                    <!-- 날씨 -->
                                    <DataGridTextColumn Header="날씨" Binding="{Binding WeatherSummary}" ElementStyle="{StaticResource TodoCellTextStyle}" Width="1.3*" MinWidth="115"/>

                                    <!-- 완료 여부 -->
                                    <DataGridTemplateColumn Header="완료" Width="0.6*" MinWidth="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 목록이 비어 있을 때 표시 -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=TodoGrid}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="나의 하루를 채워 보세요" Foreground="DarkSlateBlue" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="작은 일정부터 차근차근 기록해 보세요." Foreground="SlateGray" FontSize="12" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 오른쪽 일정 입력란 -->
                <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="PLAN DETAILS" Foreground="SlateGray" FontSize="10"/>
                                <TextBlock Text="일정 작성" FontSize="21" FontWeight="Bold" Margin="0,7,0,0"/>

                                <!-- 제목 -->
                                <TextBlock Text="제목" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TitleBox"/>

                                <!-- 내용 -->
                                <TextBlock Text="내용" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ContentBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>

                                <!-- 활동 시작 -->
                                <TextBlock Text="활동 시작" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="StartDatePicker"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="StartPeriodComboBox" Grid.Column="0" Margin="0,0,8,0" IsEditable="False" ToolTip="시작 시간의 오전 또는 오후를 선택하세요."/>
                                    <ComboBox x:Name="StartHourComboBox" Grid.Column="1" Margin="0,0,8,0" IsEditable="False" ToolTip="시작 시각을 선택하세요.">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0:00}시}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox x:Name="StartMinuteComboBox" Grid.Column="2" IsEditable="False" ToolTip="시작 분을 10분 단위로 선택하세요.">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0:00}분}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <!-- 활동 종료 -->
                                <CheckBox x:Name="HasEndDateCheckBox" Content="활동 종료 시간 설정" IsChecked="True" Margin="0,17,0,9"/>
                                <Grid IsEnabled="{Binding IsChecked, ElementName=HasEndDateCheckBox}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DatePicker x:Name="EndDatePicker"/>
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="EndPeriodComboBox" Grid.Column="0" Margin="0,0,8,0" IsEditable="False" ToolTip="종료 시간의 오전 또는 오후를 선택하세요."/>
                                        <ComboBox x:Name="EndHourComboBox" Grid.Column="1" Margin="0,0,8,0" IsEditable="False" ToolTip="종료 시각을 선택하세요.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat={}{0:00}시}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox x:Name="EndMinuteComboBox" Grid.Column="2" IsEditable="False" ToolTip="종료 분을 10분 단위로 선택하세요.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat={}{0:00}분}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Grid>

                                <!-- 활동 장소 -->
                                <TextBlock Text="활동 장소" Style="{StaticResource FieldLabel}"/>

                                <Border Background="GhostWhite" CornerRadius="8" Padding="12" Margin="0,0,0,8">

                                    <TextBlock x:Name="SelectedMapLocationText" Text="아직 선택한 장소가 없습니다." Foreground="DarkSlateGray"
                                     FontSize="15" TextWrapping="Wrap" LineHeight="25"/>
                                </Border>

                                <Button x:Name="SelectMapLocationButton" Content="장소 검색 / 지도에서 선택" Background="Lavender" Foreground="DarkSlateBlue"
                                 Click="SelectMapLocationButton_Click"/>

                                <TextBlock Text="선택한 장소는 일정 등록 또는 수정 시 저장됩니다." Foreground="SlateGray" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>

                                <!-- 완료 여부 -->
                                <CheckBox x:Name="IsCompletedCheckBox" Content="완료한 일정" Margin="0,20,0,12"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 아래쪽 작업 버튼 -->
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <Button x:Name="CreateButton" Content="일정 등록" Background="SlateBlue" Foreground="White" Click="CreateButton_Click"/>
                            <UniformGrid Columns="3" Margin="0,9,0,0">
                                <Button x:Name="UpdateButton" Content="수정" Margin="0,0,5,0" Click="UpdateButton_Click"/>
                                <Button x:Name="DeleteButton" Content="삭제" Background="MistyRose" Foreground="IndianRed" Margin="3,0,3,0" Click="DeleteButton_Click"/>
                                <Button x:Name="ClearButton" Content="초기화" Background="WhiteSmoke" Foreground="SlateGray" Margin="5,0,0,0" Click="ClearButton_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 하단 알림 및 상태 메시지 -->
            <StackPanel Grid.Row="2" Margin="0,14,0,0">

                <!-- 실제 날씨 변경이 있을 때 표시할 알림 영역 -->
                <Border x:Name="WeatherNotificationPanel" Background="Lavender" CornerRadius="12" Padding="14" Visibility="Collapsed" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="날씨 변경 알림" Foreground="DarkSlateBlue" FontWeight="SemiBold"/>
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                                <TextBlock x:Name="WeatherNotificationText" Foreground="DarkSlateGray" FontSize="15" 
                                           LineHeight="25" TextWrapping="Wrap" Margin="0,5,0,0"/>

                            </ScrollViewer>
                        </StackPanel>
                        <Button Grid.Column="1" Content="닫기" Background="White" Padding="12,6" VerticalAlignment="Center" Click="DismissWeatherNotification_Click"/>
                    </Grid>
                </Border>

                <!-- 선택한 일정의 날씨 -->
                <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="선택한 일정의 날씨" FontSize="17" FontWeight="SemiBold" Foreground="DarkSlateBlue" Margin="0,0,0,10"/>
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="WeatherUpdateText" Text="날씨를 확인할 일정을 선택해 주세요." FontSize="15" Foreground="DarkSlateGray" TextWrapping="Wrap" LineHeight="27"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusMessage" Text="오늘의 일정도 나만의 속도로 완성해 보세요." Foreground="DarkSlateGray" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,5,0,0"/>
            </StackPanel>

        </Grid>

    </Grid>

</Window>