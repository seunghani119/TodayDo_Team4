<Window x:Class="TODOList.Client.TodoDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TodayDo · 일정 보기" Width="1040" Height="780" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="WhiteSmoke" Foreground="DarkSlateGray" FontFamily="맑은 고딕" FontSize="16">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Lavender"/>
            <Setter Property="Foreground" Value="DarkSlateBlue"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="SlateGray"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="LineHeight" Value="31"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="26,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,8,12" CornerRadius="10">
                            <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" HorizontalAlignment="Center" TextElement.FontWeight="SemiBold" TextElement.Foreground="SlateGray"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="Lavender"/>
                                <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="DarkSlateBlue"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="GhostWhite"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="White" CornerRadius="18" Padding="24" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="TODAYDO · PLAN DETAILS" Foreground="SlateBlue" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TitleText" FontSize="28" FontWeight="Bold" Foreground="MidnightBlue" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HeaderSummaryText" Foreground="SlateGray" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="1" Background="Lavender" CornerRadius="10" Padding="14,8" VerticalAlignment="Top">
                    <TextBlock x:Name="CompletionText" Foreground="DarkSlateBlue" FontSize="14" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>
        <TabControl x:Name="DetailTabs" Grid.Row="1" Background="Transparent" Foreground="DarkSlateGray" BorderThickness="0" Padding="0">
            <TabItem Header="일정 정보">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                    <StackPanel>
                        <Border Background="White" CornerRadius="16" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="활동 시작" Style="{StaticResource Label}"/><TextBlock x:Name="StartText" Style="{StaticResource Body}" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="활동 종료" Style="{StaticResource Label}"/><TextBlock x:Name="EndText" Style="{StaticResource Body}" FontWeight="SemiBold"/></StackPanel>
                                </Grid>
                                <Border Height="1" Background="WhiteSmoke" Margin="0,20"/>
                                <TextBlock Text="활동 장소" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="LocationText" Style="{StaticResource Body}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="16" Padding="24">
                            <StackPanel><TextBlock Text="일정 내용" Style="{StaticResource Label}"/><TextBlock x:Name="ContentText" Style="{StaticResource Body}"/></StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="시간별 날씨">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock x:Name="WeatherStatusText" Text="날씨를 확인하고 있습니다." FontWeight="SemiBold" Foreground="DarkSlateBlue" TextWrapping="Wrap"/>
                                <TextBlock x:Name="WeatherCheckedText" Foreground="SlateGray" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="기상청 예보 원본을 시간별로 표시합니다. AI 조언을 받으면 그 조언에 사용한 예보로 맞춰집니다." Foreground="SlateGray" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Button x:Name="RefreshWeatherButton" Grid.Column="1" Content="날씨 새로고침" VerticalAlignment="Top" Click="RefreshWeatherButton_Click"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="10">
                        <DataGrid x:Name="WeatherGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="WhiteSmoke"
                                  Background="White" BorderThickness="0" RowHeight="64" ColumnHeaderHeight="48" FontSize="15" SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="GhostWhite"/><Setter Property="Foreground" Value="DarkSlateBlue"/><Setter Property="Padding" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                                <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="예보 시간" Binding="{Binding Time}" Width="1.3*" MinWidth="110"/>
                                <DataGridTextColumn Header="하늘" Binding="{Binding Sky}" Width="*" MinWidth="90"/>
                                <DataGridTextColumn Header="기온" Binding="{Binding Temperature}" Width="0.8*" MinWidth="70"/>
                                <DataGridTextColumn Header="강수 형태" Binding="{Binding Type}" Width="1.1*" MinWidth="100"/>
                                <DataGridTextColumn Header="강수확률" Binding="{Binding Probability}" Width="*" MinWidth="90"/>
                                <DataGridTextColumn Header="강수량" Binding="{Binding Rain}" Width="1.3*" MinWidth="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="AI 조언">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                        <StackPanel>
                            <Border Background="Lavender" CornerRadius="16" Padding="22" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="일정에 맞는 준비를 도와드릴게요" FontSize="21" FontWeight="Bold" Foreground="DarkSlateBlue" TextWrapping="Wrap"/>
                                    <TextBlock Text="AI가 입력한 제목과 내용, 실제 예보를 읽고 조언합니다." Style="{StaticResource Body}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="16" Padding="24" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="AiStatusText" Text="아직 조언을 확인하지 않았습니다." Foreground="SlateGray" FontSize="14" Margin="0,0,0,14"/>
                                    <TextBlock x:Name="AiAdviceText" Text="일정 내용에 맞는 준비물과 활동 팁을 이곳에서 편하게 읽어보세요." FontSize="18" LineHeight="34" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AiCheckedText" Foreground="SlateGray" FontSize="13" TextWrapping="Wrap" Margin="0,18,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="GhostWhite" CornerRadius="14" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="조언에 사용한 예보" Foreground="DarkSlateBlue" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="시간별 날씨 탭에서 조언에 사용한 예보를 확인할 수 있습니다. 예보가 없거나 일부만 있으면 AI도 그 범위를 기준으로 안내합니다." Style="{StaticResource Body}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="CheckAiButton" Grid.Row="1" Content="AI 조언 확인" Background="SlateBlue" Foreground="White" HorizontalAlignment="Right" Margin="0,14,0,0" IsEnabled="False" Click="CheckAiButton_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="저장된 일정입니다. 변경 사항은 메인 화면에서 저장해 주세요." Foreground="SlateGray" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
            <Button Grid.Column="1" Content="닫기" IsCancel="True" Click="CloseDetailButton_Click"/>
            <Button Grid.Column="3" Content="수정하기" Background="SlateBlue" Foreground="White" Click="EditTodoButton_Click"/>
        </Grid>
    </Grid>
</Window>
